    {
      "id": "quotePropose",
      "method": "POST",
      "path": "/v1/ledgers/:id/quotes",
      "authentication": "session-active",
      "source": "services/backend/src/quotes.ts",
      "paramsSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "message"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "scheduleAt": {
            "type": "string",
            "format": "date-time"
          },
          "priceType": {
            "type": "string",
            "enum": [
              "HOURLY",
              "TOTAL"
            ]
          },
          "vatIncluded": {
            "type": "boolean"
          },
          "hourlyRate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "responses": {
        "201": {
          "$ref": "#/definitions/Quote"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "when": "schema violation"
        },
        {
          "status": 400,
          "code": "INVALID_EXPIRY",
          "when": "expiresAt is not at least 60 seconds in the future"
        },
        {
          "status": 400,
          "code": "EXPIRY_EXCEEDS_MAX_TTL",
          "when": "expiresAt is more than 30 days in the future"
        },
        {
          "status": 400,
          "code": "HOURLY_RATE_REQUIRED",
          "when": "priceType=HOURLY but hourlyRate is omitted"
        },
        {
          "status": 400,
          "code": "HOURLY_RATE_NOT_ALLOWED",
          "when": "priceType=TOTAL but hourlyRate is present"
        },
        {
          "status": 401,
          "code": "AUTH_REQUIRED",
          "when": "missing or malformed Authorization header"
        },
        {
          "status": 403,
          "code": "ACCOUNT_RESTRICTED",
          "when": "member has an active restriction"
        },
        {
          "status": 403,
          "code": "EXPERT_ONLY",
          "when": "caller is a participant but not the ledger's expert"
        },
        {
          "status": 404,
          "code": "LEDGER_NOT_FOUND",
          "when": "ledger does not exist or caller is not a participant"
        }
      ]
    },
