# Replace with the image published by GitHub Actions (commit SHA or digest).
BACKEND_IMAGE=ghcr.io/mintechstrategy/kimgosu-backend:COMMIT_SHA
HTTP_PORT=8080
# Router forwards external TCP 23912 directly to this PC. Port 23913 stays LAN only.
LAN_BIND_IP=192.168.0.213
LAN_HTTP_PORT=23912
LAN_TEST_PORT=23913
TEST_LOGIN_ENABLED=false
POSTGRES_DB=kimgosu
POSTGRES_USER=kimgosu

# Absolute Windows path; use forward slashes in Compose environment values.
STORAGE_ROOT=G:/shared_storage/kimgosu
# Add the exact browser origins when the web frontend is deployed.
FRONTEND_ORIGINS=
