# Allowlist only the backend build inputs; never send local credentials/logs/apps.
**
!Dockerfile
!.dockerignore
!services/
!services/backend/
!services/backend/package.json
!services/backend/package-lock.json
!services/backend/tsconfig.json
!services/backend/src/
!services/backend/src/**
!contracts/
!contracts/**
# Defence in depth if sensitive files are ever placed in an allowed directory.
**/.env
**/.env.*
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.mobileprovision
