# Allowlist only the backend build inputs; never send local credentials/logs/apps.
**
!Dockerfile
!.dockerignore
!services/
services/**
!services/backend/
services/backend/**
!services/backend/Dockerfile
!services/backend/package.json
!services/backend/package-lock.json
# Allow the whole source directory. Naming individual files here means every
# module added later is silently dropped from the build context, and the image
# then fails at import time.
!services/backend/src/
!services/backend/src/**
# Defence in depth if sensitive files are ever placed in an allowed directory.
**/.env
**/.env.*
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.mobileprovision
