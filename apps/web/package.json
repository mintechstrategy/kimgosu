  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.14",
    "@types/node": "24.12.0"
  }
}
